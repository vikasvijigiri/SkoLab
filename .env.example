# ==============================================================================
# SkoLab Monorepo Environment Variables Example
# Copy this file to respective service directories or use as reference
#
# 2026-09-27: the backend was cut down to authentication, authorization, and
# CoLab (workspace collaboration + LaTeX compile) only. Every env var below
# is used by that surface; nothing here configures a removed domain.
# ==============================================================================

# Database Settings — Supabase Postgres is the only backend, in every
# environment (local dev, CI's ephemeral test container aside, staging,
# production). Get this from Supabase Project Settings -> Database ->
# Connection string (the *transaction pooler*, port 6543, under real
# concurrency — see the pool-size tunables below). Do not commit real
# credentials.
#
# The Python service and the Go gateway both read this SAME env var name but
# want it in slightly different formats:
#   Python (asyncpg driver): postgresql+asyncpg://user:pass@host:port/dbname
#   Go (pgx, no driver suffix): postgresql://user:pass@host:port/dbname
# Set each service's own DATABASE_URL accordingly — see
# services/backend/.env for the Python-side example.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Python Backend (FastAPI) Settings
PORT=8000

# Go API Gateway Settings
PYTHON_BACKEND_URL=http://localhost:8000
GIN_MODE=release

# Shared secret for internal/service-to-service calls (Go gateway <->
# colab-sandbox worker, and the Go gateway's temporary fallback proxy to
# Python's own /colab/compile). Empty ⇒ the check is skipped (no local-dev
# configuration needed). Set the SAME value everywhere in staging/production —
# both app/core/config.py and the Go gateway's main() refuse to boot under
# APP_ENV=staging|production / GIN_MODE=release if this is empty. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# At-rest encryption key for sensitive DB columns (Fernet). Distinct from
# EMAIL_BLIND_INDEX_KEY below. Must decode to exactly 32 url-safe base64
# bytes — generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development tolerates the shipped placeholder default (unset is fine);
# app/core/config.py refuses to boot under APP_ENV=staging|production with
# it unset or left at that default.
DATABASE_ENCRYPTION_KEY=

# Observability — leave empty to disable Sentry (the SDK is never initialised)
SENTRY_DSN=

# One application telemetry pipeline: OTLP HTTP/protobuf -> Grafana Cloud.
# Base endpoint includes /otlp, but not /v1/metrics or /v1/traces.
# Empty endpoint keeps export disabled. Never commit the real header/token.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER_ARG=1
OTEL_SDK_DISABLED=false
# Defaults differ per service; set explicitly in each deployment.
# OTEL_SERVICE_NAME=skolab-gateway or skolab-backend-py

# Deterministic blind index for equality lookups on the encrypted users.email
# column. Both services must use the SAME value. Distinct from
# DATABASE_ENCRYPTION_KEY. Any non-empty string; rotating it invalidates
# existing users.email_bidx values (re-run
# services/backend/scripts/backfill_email_bidx.py). Empty ⇒ email matching is
# silently skipped.
EMAIL_BLIND_INDEX_KEY=

# Firebase Admin SDK service account (Python and Go both read this same
# path). Required for either service to actually verify a real Firebase ID
# token — without it, every protected route gets 401, even with a
# genuinely valid token from a signed-in client. Get one from Firebase
# Console → Project Settings → Service Accounts → Generate new private key.
# Never commit the downloaded JSON file itself.
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Scale and latency tunables (all optional; defaults are production-safe)
# ------------------------------------------------------------------------------

# APP_ENV=production also stops the Python backend running create_all/ALTER on
# every start — schema is then Alembic's job (`alembic upgrade head` on deploy).
# Force it either way with RUN_DB_CREATE_ALL=1|0.
APP_ENV=development
# RUN_DB_CREATE_ALL=

# Python: uvicorn worker processes. One event loop each.
WEB_CONCURRENCY=1

# Both services should point DATABASE_URL at the Supabase *transaction pooler*
# (host ...pooler.supabase.com, port 6543) under real concurrency. Pool sizes
# below are per Python worker / per Go instance — keep the product under the
# free pooler's ~60 server connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Go gateway pool (its own env names):
DB_MAX_CONNS=15
DB_MIN_CONNS=3

# Per-user cost quota for /colab/compile — counted per verified Firebase uid
# in Redis (REDIS_URL) or the usage_counters table, so it holds across
# replicas. See app/core/quota.py / internal/quota (Go).
# USER_QUOTA_ENABLED=true
# USER_QUOTA_HOURLY_UNITS=150
# USER_QUOTA_DAILY_UNITS=600

# CoLab LaTeX compile worker — see docs/deploy/colab-sandbox.md. Unset ⇒
# the gateway falls back to the existing (still-hardened, less isolated)
# Python /colab/compile route. Set once services/backend-go/cmd/colab-sandbox
# is deployed as its own container (Cloud Run/Fargate).
# COLAB_SANDBOX_URL=

# CoLab LaTeX compiler: max simultaneous pdflatex processes per worker (each is
# CPU-bound, 20 s max). Extra requests get 503 + Retry-After.
# COLAB_MAX_CONCURRENT_COMPILES=2

# Optional: distributed L2 cache for the quota system. Without it, quota
# counters fall back to Postgres.
# REDIS_URL=
