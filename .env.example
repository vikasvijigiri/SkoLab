# ==============================================================================
# SkoLab Monorepo Environment Variables Example
# Copy this file to respective service directories or use as reference
# ==============================================================================

# Database Settings — Supabase Postgres is the only backend, in every
# environment (local dev, CI's ephemeral test container aside, staging,
# production). Get this from Supabase Project Settings -> Database ->
# Connection string (the *transaction pooler*, port 6543, under real
# concurrency — see the pool-size tunables below). Do not commit real
# credentials.
#
# The Python service and the Go gateway both read this SAME env var name but
# want it in slightly different formats:
#   Python (asyncpg driver): postgresql+asyncpg://user:pass@host:port/dbname
#   Go (pgx, no driver suffix): postgresql://user:pass@host:port/dbname
# Set each service's own DATABASE_URL accordingly — see
# services/backend/.env for the Python-side example.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Python Backend (FastAPI) Settings
GROQ_API="your_groq_api_key"
PORT=8000
LAN_IP="127.0.0.1"

# OpenAlex API key — free, from https://openalex.org/settings/api (~30s signup).
# OpenAlex retired the mailto "polite pool" before Feb 2026; a key is now the
# only way to raise limits (~10x the keyless daily budget; bursts 429 without
# one). Read by the Python OpenAlex service and Go gateway client under this
# same name.
OPENALEX_API_KEY=
# Optional, descriptive only now (no longer affects rate limits) — used in the
# OpenAlex User-Agent string.
OPENALEX_EMAIL=

# Go API Gateway Settings
PYTHON_BACKEND_URL=http://localhost:8000
GIN_MODE=release

# Reverse direction: Python -> Go, used only by researcher_worker.py's
# teleport worker to call POST {GATEWAY_URL}/internal/compute-metrics.
GATEWAY_URL=http://localhost:8080

# Shared secret for internal/service-to-service calls, both directions.
# Empty ⇒ the check is skipped on both sides (no local-dev configuration
# needed). Set the SAME value on both services in staging/production —
# both app/core/config.py and the Go gateway's main() now refuse to boot
# under APP_ENV=staging|production / GIN_MODE=release if this is empty
# (2026-09-26 security audit: an unset token previously left every
# /internal/* route silently unauthenticated with no warning). Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# At-rest encryption key for sensitive DB columns (Fernet). Distinct from
# EMAIL_BLIND_INDEX_KEY below. Must decode to exactly 32 url-safe base64
# bytes — generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development tolerates the shipped placeholder default (unset is fine);
# app/core/config.py refuses to boot under APP_ENV=staging|production with
# it unset or left at that default.
DATABASE_ENCRYPTION_KEY=

# Observability — leave empty to disable Sentry (the SDK is never initialised)
SENTRY_DSN=

# Deterministic blind index for equality lookups on the encrypted users.email
# column (powers /recommendations/peers/check-registered). Both services must
# use the SAME value. Distinct from DATABASE_ENCRYPTION_KEY. Any non-empty
# string; rotating it invalidates existing users.email_bidx values (re-run
# services/backend/scripts/backfill_email_bidx.py). Empty ⇒ email matching is
# silently skipped.
EMAIL_BLIND_INDEX_KEY=

# Firebase Admin SDK service account (Python and Go both read this same
# path). Required for either service to actually verify a real Firebase ID
# token — without it, every request to a Firebase-authenticated route
# (/agent/*, /users/quests, workspace websockets, ...) gets 401, even with a
# genuinely valid token from a signed-in client. Get one from Firebase
# Console → Project Settings → Service Accounts → Generate new private key.
# Never commit the downloaded JSON file itself.
GOOGLE_APPLICATION_CREDENTIALS=

# Secondary LLM provider (fallback after Groq — see LLM_MAX_FALLBACK_MODELS
# below). From https://openrouter.ai/keys. Optional: is_llm_working() still
# returns true on Groq alone.
OPENROUTER_API_KEY=

# Hugging Face Inference API token, for the embeddings model (no local
# PyTorch in the image — see services/backend/Dockerfile's header comment).
# From https://huggingface.co/settings/tokens. Unset ⇒ embeddings degrade to
# a local model if installed (dev/CI), else zero vectors.
HF_INFERENCE_TOKEN=

# ------------------------------------------------------------------------------
# Scale and latency tunables (all optional; defaults are production-safe)
# ------------------------------------------------------------------------------

# APP_ENV=production also stops the Python backend running create_all/ALTER on
# every start — schema is then Alembic's job (`alembic upgrade head` on deploy).
# Force it either way with RUN_DB_CREATE_ALL=1|0.
APP_ENV=development
# RUN_DB_CREATE_ALL=

# Python: uvicorn worker processes. One event loop each; each also loads its own
# copy of the embedding model (~130 MB). 1 on a 512 MB box; 2+ on a 16 GB Space.
WEB_CONCURRENCY=1

# Both services should point DATABASE_URL at the Supabase *transaction pooler*
# (host ...pooler.supabase.com, port 6543) under real concurrency. Pool sizes
# below are per Python worker / per Go instance — keep the product under the
# free pooler's ~60 server connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Go gateway pool (its own env names):
DB_MAX_CONNS=15
DB_MIN_CONNS=3

# Max concurrent embedding forward passes (0 = the container's core count).
EMBED_MAX_CONCURRENCY=0
# EMBED_VECTOR_CACHE_TTL_SECONDS=2592000

# LLM fallback bounds — cap attempts and total wall-clock per user request.
LLM_MAX_FALLBACK_MODELS=4
LLM_TOTAL_DEADLINE_SECONDS=90

# Optional: distributed L2 cache. Without it, cache traffic hits Postgres.
# REDIS_URL=
