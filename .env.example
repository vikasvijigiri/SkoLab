# ==============================================================================
# SkoLab Monorepo Environment Variables Example
# Copy this file to respective service directories or use as reference
# ==============================================================================

# Database Settings
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/skolab

# Python Backend (FastAPI) Settings
GROQ_API="your_groq_api_key"
PORT=8000
LAN_IP="127.0.0.1"

# Go API Gateway Settings
PYTHON_BACKEND_URL=http://localhost:8000
GIN_MODE=release
