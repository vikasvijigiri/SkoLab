# ==============================================================================
# SkoLab Monorepo Environment Variables Example
# Copy this file to respective service directories or use as reference
# ==============================================================================

# Database Settings
# If your local Postgres requires authentication, add the user and password to
# the URL. Do not commit real credentials.
DATABASE_URL=postgresql://localhost:5432/skolab

# Python Backend (FastAPI) Settings
GROQ_API="your_groq_api_key"
PORT=8000
LAN_IP="127.0.0.1"

# Go API Gateway Settings
PYTHON_BACKEND_URL=http://localhost:8000
GIN_MODE=release

# Observability — leave empty to disable Sentry (the SDK is never initialised)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Scale / latency tunables (all optional — sane defaults; see
# docs/plans/2026-09-02-scale-latency-audit.md)
# ------------------------------------------------------------------------------

# APP_ENV=production also stops the Python backend running create_all/ALTER on
# every start — schema is then Alembic's job (`alembic upgrade head` on deploy).
# Force it either way with RUN_DB_CREATE_ALL=1|0.
APP_ENV=development
# RUN_DB_CREATE_ALL=

# Python: uvicorn worker processes. One event loop each; each also loads its own
# copy of the embedding model (~130 MB). 1 on a 512 MB box; 2+ on a 16 GB Space.
WEB_CONCURRENCY=1

# Both services should point DATABASE_URL at the Supabase *transaction pooler*
# (host ...pooler.supabase.com, port 6543) under real concurrency. Pool sizes
# below are per Python worker / per Go instance — keep the product under the
# free pooler's ~60 server connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Go gateway pool (its own env names):
DB_MAX_CONNS=15
DB_MIN_CONNS=3

# Max concurrent embedding forward passes (0 = the container's core count).
EMBED_MAX_CONCURRENCY=0
# EMBED_VECTOR_CACHE_TTL_SECONDS=2592000

# LLM fallback bounds — cap attempts and total wall-clock per user request.
LLM_MAX_FALLBACK_MODELS=4
LLM_TOTAL_DEADLINE_SECONDS=90

# Optional: distributed L2 cache. Without it, cache traffic hits Postgres.
# REDIS_URL=
