# Go API gateway (author search, feed, recommendations, user profile sync). CORS is
# already configured on the gateway for http://localhost:3000 — see services/backend-go.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase Web app config for project "skolab-vvi" (same project as the Android app,
# apps/android-app/app/google-services.json). No web app is registered there yet —
# create one in the Firebase console (Project settings -> Add app -> Web) and paste
# the resulting config values below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skolab-vvi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skolab-vvi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skolab-vvi.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# Reused from the Android app's OAuth web client (google-services.json, client_type 3).
# Only override if you register a separate web OAuth client.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=412488544680-jr969qv6a5aih569rmd8l8egjetl9lrg.apps.googleusercontent.com
