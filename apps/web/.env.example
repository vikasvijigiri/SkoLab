# Build-time configuration for the web app. All values are public: they
# identify the Firebase project and the API, they grant no access.
# Copy to .env.local for development; set them on Render for production.

# The gateway's public URL, no trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
