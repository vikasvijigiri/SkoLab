<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Skolab.Input" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/color_bg_subtle</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/color_text_muted</item>
        <item name="android:textColorHint">@color/color_text_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
    </style>

    <style name="Widget.Skolab.Input.Search" parent="Widget.Skolab.Input">
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/color_text_muted</item>
    </style>

    <style name="Widget.Skolab.Input.Error" parent="Widget.Skolab.Input">
        <item name="boxStrokeColor">@color/color_error</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="errorTextColor">@color/color_error</item>
    </style>
</resources>
