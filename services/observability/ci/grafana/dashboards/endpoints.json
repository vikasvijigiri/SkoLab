{
  "uid": "skolab-ci-endpoints",
  "title": "SkoLab API endpoints (CI)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "skolab",
    "ci"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "skolab-gateway,skolab-backend-py",
        "current": {
          "text": "skolab-gateway",
          "value": "skolab-gateway"
        },
        "options": [
          {
            "text": "skolab-gateway",
            "value": "skolab-gateway",
            "selected": true
          },
          {
            "text": "skolab-backend-py",
            "value": "skolab-backend-py",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by URL",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(skolab_http_requests_total{service_name=\"$service\"}[30s]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency, by URL",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(skolab_http_request_duration_seconds_bucket{service_name=\"$service\"}[30s])))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 latency, by URL",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, http_request_method, http_route) (rate(skolab_http_request_duration_seconds_bucket{service_name=\"$service\"}[30s])))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server errors (5xx) per second, by URL",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate({__name__=\"skolab_http_requests_total\",service_name=\"$service\",http_response_status_code=~\"5..\"}[30s]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Responses per second, by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(skolab_http_requests_total{service_name=\"$service\"}[30s]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "In-flight requests",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(skolab_http_active_requests{service_name=\"$service\"})",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Span p95 from traces (spanmetrics), by span",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket[30s])))",
          "legendFormat": "{{service_name}} {{span_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Per-URL summary over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (increase(skolab_http_requests_total{service_name=\"$service\"}[$__range]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, http_request_method, http_route) (increase(skolab_http_request_duration_seconds_bucket{service_name=\"$service\"}[$__range]))) * 1000",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (increase(skolab_http_request_duration_seconds_bucket{service_name=\"$service\"}[$__range]))) * 1000",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le, http_request_method, http_route) (increase(skolab_http_request_duration_seconds_bucket{service_name=\"$service\"}[$__range]))) * 1000",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "p50 ms",
              "Value #C": "p95 ms",
              "Value #D": "p99 ms",
              "http_route": "URL",
              "http_request_method": "Method"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": []
      }
    }
  ]
}