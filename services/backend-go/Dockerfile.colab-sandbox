# colab-sandbox: a minimal, standalone LaTeX compile worker.
#
# Build context is THIS directory (services/backend-go), because the binary
# is cmd/colab-sandbox from the same Go module as the main gateway — this is
# a second Dockerfile into the same source tree, not a separate service
# directory. See docs/deploy/colab-sandbox.md for the exact build/push/
# deploy commands (build: docker build -f Dockerfile.colab-sandbox .).
#
# Deploy separately from the main API. Long-lived workers and Cloud Run
# can reuse a container across requests; concurrency 1 is not per-job container
# isolation. See deploy/RELIABILITY.md for the rollout and isolation limits.
#
# Deliberately tiny: a static Go binary + pdflatex + util-linux (for
# prlimit). No Python, no Firebase, no database driver — this process holds
# exactly one secret (INTERNAL_API_TOKEN) and nothing else worth stealing.

FROM golang:1.26-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
    -o /out/colab-sandbox ./cmd/colab-sandbox

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
# The same TeX packages as deploy/skolab-api/Dockerfile, so the editor's
# templates compile on either backend.
# Apply available security fixes to packages inherited from the base image.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    lmodern \
    texlive-publishers \
    texlive-science \
    texlive-latex-extra \
    util-linux \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/* && \
    groupadd -g 10001 sandbox && \
    useradd -u 10001 -g sandbox -s /usr/sbin/nologin -m sandbox

COPY --from=builder /out/colab-sandbox /usr/local/bin/colab-sandbox
USER sandbox
WORKDIR /home/sandbox

ENV PORT=8081
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s CMD ["wget", "-qO-", "http://127.0.0.1:8081/healthz"]

ENTRYPOINT ["/usr/local/bin/colab-sandbox"]
