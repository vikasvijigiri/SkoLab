# ──────────────────────────────────────────────────────────────────────────────
# Skolab Backend — Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and fill in your actual credentials/configs.
# Do NOT commit '.env' to git!
# ──────────────────────────────────────────────────────────────────────────────

# ── External API Keys ─────────────────────────────────────────────────────────
# OpenAlex API key (used for academic paper metadata and metrics query)
openalex_api="YOUR_OPENALEX_API_KEY_HERE"

# Groq API key (used for fast LLM agent tasks)
GROQ_API="YOUR_GROQ_API_KEY_HERE"

# OpenRouter API key (used for model fallback/diverse models)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"

# Firebase / Google Cloud credentials JSON filepath
GOOGLE_APPLICATION_CREDENTIALS="service-account.json"


# ── Database ──────────────────────────────────────────────────────────────────
# Connection URL format: postgresql+asyncpg://user:password@host:port/dbname
# E.g. postgresql+asyncpg://postgres:ResQit2025!@127.0.0.1:5432/skolab
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/skolab"

# AES-128/HMAC-SHA256 key for database record-level encryption and integrity signing.
# SECURITY CRITICAL: MUST be changed from the default value before production deployment!
# Generate a strong key with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: Changing this key will invalidate all existing encrypted records in the database.
DATABASE_ENCRYPTION_KEY="YOUR_STRONG_RANDOM_BASE64_KEY_HERE"


# ── Server Config ─────────────────────────────────────────────────────────────
# Port on which the FastAPI application will run (default is 8000)
PORT=8000

# Public base URL of the app. Used for building static download URLs,
# OpenRouter HTTP-Referer headers, and redirects.
# Default in development: http://localhost:8000
# E.g. in production: APP_BASE_URL="https://api.skolab.app"
# APP_BASE_URL="http://localhost:8000"

# Optional path to save downloaded files. Defaults to <backend_root>/downloads
# DOWNLOADS_DIR="/path/to/downloads"


# ── mDNS Zeroconf Advertisement ────────────────────────────────────────────────
# MUST match AppConfig.MDNS_SERVICE_NAME / AppConfig.MDNS_SERVICE_TYPE in the Android app.
# By default, SkoLabBackend is used.
MDNS_SERVICE_NAME="SkoLabBackend"
MDNS_SERVICE_TYPE="_http._tcp.local."


# ── Monitoring ────────────────────────────────────────────────────────────────
# Full name of the primary researcher — used by add_monitors.py to resolve the
# OpenAlex author ID at runtime and seed parameterised health-check monitors.
MONITOR_AUTHOR_NAME="Your Full Name Here"


# ── SRE Operations ─────────────────────────────────────────────────────────────
# Comma-separated list of route feature prefixes to disable via kill switch.
# E.g. KILL_SWITCHES="collaborator/synergy,agent/chat"
# Leave empty (default) to disable no features.
KILL_SWITCHES=""


# ── Alert Routing (Alertmanager / PagerDuty) ───────────────────────────────────
# PagerDuty integration routing key for primary on-call SRE alerts.
# Obtain from: PagerDuty Dashboard -> Services -> SkoLab Backend -> Integrations.
PAGERDUTY_PRIMARY_ONCALL_KEY="YOUR_PAGERDUTY_PRIMARY_ROUTING_KEY"

# PagerDuty integration routing key for Database SRE escalation.
PAGERDUTY_DB_SRE_KEY="YOUR_PAGERDUTY_DB_SRE_ROUTING_KEY"

# SMTP password for Alertmanager email receiver.
# Used by infra/alertmanager.yml to send email notifications on warning-level alerts.
SMTP_AUTH_PASSWORD="YOUR_SMTP_PASSWORD_HERE"
