# ──────────────────────────────────────────────────────────────────────────────
# Skolab Backend — Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and fill in your actual credentials/configs.
# Do NOT commit '.env' to git!
# ──────────────────────────────────────────────────────────────────────────────

# ── External API Keys ─────────────────────────────────────────────────────────
# OpenAlex API key (used for academic paper metadata and metrics query)
openalex_api="YOUR_OPENALEX_API_KEY_HERE"

# Groq API key (used for fast LLM agent tasks)
GROQ_API="YOUR_GROQ_API_KEY_HERE"

# OpenRouter API key (used for model fallback/diverse models)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"

# Firebase / Google Cloud credentials JSON filepath
GOOGLE_APPLICATION_CREDENTIALS="service-account.json"


# ── Database ──────────────────────────────────────────────────────────────────
# Connection URL format: postgresql+asyncpg://user:password@host:port/dbname
# E.g. postgresql+asyncpg://postgres:ResQit2025!@127.0.0.1:5432/skolab
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/skolab"


# ── Server Config ─────────────────────────────────────────────────────────────
# Port on which the FastAPI application will run (default is 8000)
PORT=8000

# Public base URL of the app. Used for building static download URLs,
# OpenRouter HTTP-Referer headers, and redirects.
# Default in development: http://localhost:8000
# E.g. in production: APP_BASE_URL="https://api.skolab.app"
# APP_BASE_URL="http://localhost:8000"

# Optional path to save downloaded files. Defaults to <backend_root>/downloads
# DOWNLOADS_DIR="/path/to/downloads"


# ── mDNS Zeroconf Advertisement ────────────────────────────────────────────────
# MUST match AppConfig.MDNS_SERVICE_NAME / AppConfig.MDNS_SERVICE_TYPE in the Android app.
# By default, SkoLabBackend is used.
MDNS_SERVICE_NAME="SkoLabBackend"
MDNS_SERVICE_TYPE="_http._tcp.local."
