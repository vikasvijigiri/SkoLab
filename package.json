{
  "name": "skolab-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared/skolab-design-system",
    "apps/web"
  ],
  "devDependencies": {
    "jsdom": "~30.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.15.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.0"
  },
  "scripts": {
    "dev:backend": "cd services/backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:go": "cd services/backend-go && go run main.go",
    "dev:web": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "build:android": "npm run compile:tokens && powershell -ExecutionPolicy Bypass -File scripts/build/build-and-install.ps1",
    "compile:tokens": "node shared/skolab-design-system/compile-tokens.js",
    "test:load:baseline": "k6 run tests/load/baseline.js",
    "test:load:rampup": "k6 run tests/load/ramp_up.js",
    "test:load:soak": "k6 run tests/load/soak.js",
    "test:load:spike": "k6 run tests/load/spike.js",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore \"vitest run --config tests/firestore/vitest.config.mts\""
  }
}
